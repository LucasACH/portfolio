---
import Base from "../layouts/Base.astro";

const site = "https://lucasachaval.com/";
const image = {
  url: new URL("/og.jpg", site).href,
  alt: "Lucas Achaval, tech lead at Shield, on a dark grainy background",
};
const title = "Lucas Achaval · Tech Lead at Shield";
const description =
  "Lucas Achaval is the tech lead at a fintech that enables stablecoin payments and US banking for global trade.";
const socialDescription =
  "Tech lead at a fintech that enables stablecoin payments and US banking for global trade.";
const links = {
  github: "https://github.com/LucasACH",
  linkedin: "https://www.linkedin.com/in/lucas-achaval",
  email: "achaval.lucas@gmail.com",
};

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lucas Achaval",
  url: site,
  image: image.url,
  jobTitle: "Tech Lead",
  worksFor: { "@type": "Organization", name: "Shield" },
  address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
  email: `mailto:${links.email}`,
  sameAs: [links.github, links.linkedin],
};
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={site} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:site_name" content="Lucas Achaval" />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </Fragment>
  <p class="loc mono rv" style="--d:50ms">Buenos Aires, Argentina</p>
  <details class="resume rv" style="--d:50ms">
    <summary>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16"></path></svg>
      Resume
      <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </summary>
    <ul>
      <li><a href="/resume/lucas-achaval-resume.pdf" download="Lucas-Achaval-Resume.pdf" type="application/pdf" hreflang="en" aria-label="Download resume in English (PDF)">English<span>PDF</span></a></li>
      <li><a href="/resume/lucas-achaval-cv.pdf" download="Lucas-Achaval-CV.pdf" type="application/pdf" hreflang="es" lang="es" aria-label="Descargar CV en español (PDF)">Español<span>PDF</span></a></li>
    </ul>
  </details>
  <div class="bottom">
    <h1><span>Lucas</span> <span>Achaval</span></h1>
    <div class="row">
      <div class="about rv" style="--d:1300ms">
        <p>I’m the tech lead at Shield, building stablecoin payments and US banking for global trade.</p>
      </div>
      <ul class="links rv" style="--d:1390ms">
        <li><a class="icon" href="https://github.com/LucasACH" target="_blank" rel="me noopener noreferrer" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg></a></li>
        <li><a class="icon" href="https://www.linkedin.com/in/lucas-achaval" target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg></a></li>
        <li><a class="icon email mono" href="mailto:achaval.lucas@gmail.com"><span>achaval.lucas@gmail.com</span></a></li>
      </ul>
    </div>
  </div>
</Base>
