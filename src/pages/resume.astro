---
import Base from "../layouts/Base.astro";
import { site, strings } from "../i18n";
import { Content } from "../resume.md";

// The resume as a crawlable page: the landing has a few words of copy, this has the full history.
const url = new URL("/resume/", site).href;
const title = "Lucas Achaval · Resume";
const description =
  "Resume of Lucas Achaval, tech lead and software engineer in fintech, payments, and stablecoins. Experience, education, and skills.";
const image = new URL(strings.en.image, site).href;
const page = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url,
  name: title,
  inLanguage: "en",
  about: { "@id": `${site}#person` },
};
---

<Base title={title} description={description} class="doc">
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <link rel="alternate" type="text/markdown" href="/resume.md" title="Lucas Achaval · Resume (Markdown)" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Lucas Achaval" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={strings.en.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(page)} />
  </Fragment>
  <nav class="mono rv" style="--d:50ms">
    <a href="/">← lucasachaval.com</a>
    <a href="/resume/lucas-achaval-resume.pdf" download="Lucas-Achaval-Resume.pdf" type="application/pdf">PDF ↓</a>
  </nav>
  <article class="rv" style="--d:150ms">
    <Content />
  </article>
</Base>
