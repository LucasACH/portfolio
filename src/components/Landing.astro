---
import Base from "../layouts/Base.astro";
import { locales, paths, site, strings, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings[lang];
const other = locales.find((l) => l !== lang)!;
const url = new URL(paths[lang], site).href;
const image = new URL(t.image, site).href;
const links = {
  github: "https://github.com/LucasACH",
  linkedin: "https://www.linkedin.com/in/lucas-achaval",
  email: "achaval.lucas@gmail.com",
};

// The visitor's own language comes first in the menu.
const resumes = [
  { lang: "en", href: "/resume/lucas-achaval-resume.pdf", download: "Lucas-Achaval-Resume.pdf", name: "English", label: "Download resume in English (PDF)" },
  { lang: "es", href: "/resume/lucas-achaval-cv.pdf", download: "Lucas-Achaval-CV.pdf", name: "Español", label: "Descargar CV en español (PDF)" },
].sort((a) => (a.lang === lang ? -1 : 1));

// Mirrors the resume, so search engines and LLMs get the facts without opening the PDF. Keep in sync with public/resume.md.
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url,
  inLanguage: lang,
  mainEntity: {
    "@type": "Person",
    "@id": `${site}#person`,
    name: "Lucas Achaval",
    givenName: "Lucas",
    familyName: "Achaval",
    url: site,
    image: new URL(strings.en.image, site).href,
    description:
      "Tech lead and software engineer in fintech, payments, and stablecoins. Early engineer at Shield and builder of its stablecoin payments system.",
    jobTitle: "Tech Lead",
    worksFor: { "@type": "Organization", name: "Shield" },
    hasOccupation: {
      "@type": "Occupation",
      name: "Software Engineer",
      skills: "TypeScript, Node.js, Fastify, PostgreSQL, Next.js, React, AWS, Terraform, Solidity, payments, stablecoins, KYC/KYB",
    },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Universidad Nacional de San Martín (UNSAM)" },
      { "@type": "CollegeOrUniversity", name: "University of Buenos Aires (UBA)" },
    ],
    knowsAbout: [
      "Software engineering",
      "Payments",
      "Stablecoins",
      "Fintech",
      "KYC/KYB",
      "TypeScript",
      "Node.js",
      "PostgreSQL",
      "Next.js",
      "React",
      "AWS",
      "Terraform",
      "Ethereum",
      "Solidity",
      "DeFi",
      "AI coding agents",
    ],
    address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
    email: `mailto:${links.email}`,
    knowsLanguage: ["es", "en", "de"],
    sameAs: [links.github, links.linkedin],
    subjectOf: [
      { "@type": "DigitalDocument", name: "Resume (PDF)", url: new URL("/resume/lucas-achaval-resume.pdf", site).href, inLanguage: "en" },
      { "@type": "DigitalDocument", name: "CV (PDF)", url: new URL("/resume/lucas-achaval-cv.pdf", site).href, inLanguage: "es" },
      { "@type": "DigitalDocument", name: "Resume (Markdown)", url: new URL("/resume.md", site).href, inLanguage: "en" },
    ],
  },
};
---

<Base lang={lang} title={t.title} description={t.description}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(paths[l], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={site} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href="/resume.md" hreflang="en" title="Lucas Achaval · Resume (Markdown)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.socialDescription} />
    <meta property="og:site_name" content="Lucas Achaval" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={strings[other].ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.socialDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={t.imageAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profile)} />
  </Fragment>
  <p class="loc mono rv" style="--d:50ms">{t.location}</p>
  <div class="actions rv" style="--d:50ms">
    <a class="lang" href={t.switchTo.href} hreflang={other} lang={other} data-lang={other} aria-label={t.switchTo.title} title={t.switchTo.title}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
      {t.switchTo.label}
    </a>
    <details class="resume">
      <summary>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16"></path></svg>
        {t.resume}
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
      </summary>
      <ul>
        {resumes.map((r) => (
          <li><a href={r.href} download={r.download} type="application/pdf" hreflang={r.lang} lang={r.lang === lang ? undefined : r.lang} aria-label={r.label}>{r.name}<span>PDF</span></a></li>
        ))}
      </ul>
    </details>
  </div>
  <div class="bottom">
    <h1><span>Lucas</span> <span>Achaval</span></h1>
    <div class="row">
      <div class="about rv" style="--d:1300ms">
        <p>{t.about}</p>
      </div>
      <ul class="links rv" style="--d:1390ms">
        <li><a class="icon" href={links.github} target="_blank" rel="me noopener noreferrer" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg></a></li>
        <li><a class="icon" href={links.linkedin} target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg></a></li>
        <li><a class="icon email mono" href={`mailto:${links.email}`}><span>{links.email}</span></a></li>
      </ul>
    </div>
  </div>
</Base>
