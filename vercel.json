{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.lucasachaval.com" }],
      "destination": "https://lucasachaval.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "lang", "value": "es" }],
      "missing": [{ "type": "query", "key": "lang" }],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^\\s*[eE][sS](?:[-;,].*)?$" }],
      "missing": [
        { "type": "cookie", "key": "lang" },
        { "type": "query", "key": "lang" }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/resume/english.pdf",
      "destination": "/resume/lucas-achaval-resume.pdf",
      "permanent": true
    },
    {
      "source": "/resume/spanish.pdf",
      "destination": "/resume/lucas-achaval-cv.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/resume/lucas-achaval-resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Lucas-Achaval-Resume.pdf\""
        }
      ]
    },
    {
      "source": "/resume/lucas-achaval-cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Lucas-Achaval-CV.pdf\""
        }
      ]
    },
    {
      "source": "/resume.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
